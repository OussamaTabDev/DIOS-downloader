[Desktop Entry]
Type=Application
Version=1.0
Name=DIOS Downloader
GenericName=Download Manager
Comment=Fast download manager: multi-connection downloads, resume, video and audio
Exec=DIOSDownloader %U
Icon=dios-downloader
Terminal=false
Categories=Network;FileTransfer;
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
Keywords=download;manager;DIOS;video;
StartupNotify=true
StartupWMClass=DIOSDownloader
